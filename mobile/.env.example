# CiviGo Mobile - Configuración de entorno
# Copia este archivo a .env dentro de mobile/ para personalizar la configuración local.

# Token público de Mapbox para el mapa interactivo y capas de tráfico
VITE_MAPBOX_TOKEN=

# URL de la API de CiviGo (Opcional).
# En desarrollo web mediante Vite, las peticiones van a /api (proxy a localhost:4000).
# En emulador Android nativo, 10.0.2.2 apunta al host local.
# En producción, configurar con el dominio público del backend (ej. https://tu-backend.up.railway.app/api).
# VITE_API_URL=http://10.0.2.2:4000/api

# Destino del proxy local de Vite (por defecto http://127.0.0.1:4000)
VITE_BACKEND_URL=http://127.0.0.1:4000
