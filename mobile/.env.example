# CiviGo Mobile - Configuración de entorno
# Copia este archivo a .env dentro de mobile/ para personalizar la configuración local.

# Token público de Mapbox para el mapa interactivo y capas de tráfico
VITE_MAPBOX_TOKEN=

# URL de la API de CiviGo (Opcional).
# En desarrollo web mediante Vite, las peticiones van a /api (proxy a localhost:4000).
# Android exige HTTPS. No incluir credenciales ni claves privadas en VITE_*.
# VITE_API_URL=https://civigo-production.up.railway.app/api

# Destino del proxy local de Vite (por defecto http://127.0.0.1:4000)
VITE_BACKEND_URL=http://127.0.0.1:4000

# Configuración pública Firebase del MISMO proyecto que utiliza el backend.
# Google Android también requiere app/google-services.json y OAuth/SHA de depuración.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Origen del enlace enviado por el backend al recuperar contraseña.
VITE_PUBLIC_APP_URL=https://civigo.online
