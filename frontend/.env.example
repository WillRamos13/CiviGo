# Same-origin API is proxied by Next.js. Keep credentials on the backend.
BACKEND_URL=http://127.0.0.1:4000
# A public, URL-restricted Mapbox token is needed to render the map.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: use an external API URL only when same-origin proxy is unavailable.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
