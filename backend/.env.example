# Railway: runtime uses the transaction pooler; migrations use DIRECT_URL.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/civigo_test?connection_limit=2
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/civigo_test?connection_limit=1
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PORT=4000
ENABLE_JOBS=true
STORAGE_PROVIDER=local
# Railway requires a persistent volume mounted at UPLOAD_DIR for local storage.
# UPLOAD_DIR=/app/uploads
UPLOAD_USER_LIMIT_MB=500
UPLOAD_DAILY_LIMIT=60
UPLOAD_PENDING_LIMIT=9
# Google verification: project id only here; public Firebase web config in Vercel.
FIREBASE_PROJECT_ID=
# Email reminders and password recovery.
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=
AI_REPORT_MODEL=gpt-6.1-sol
AI_CHAT_MODEL=gpt-4.1-mini
# Shared UTC request limits across replicas. 0 pauses that AI service.
# These limit attempts, not exact cost; also monitor provider usage and billing.
AI_CHAT_DAILY_REQUEST_LIMIT=1000
AI_CHAT_MONTHLY_REQUEST_LIMIT=15000
AI_REPORT_DAILY_REQUEST_LIMIT=200
AI_REPORT_MONTHLY_REQUEST_LIMIT=3000
# Optional reverse image search; private key only in Railway, never Firebase's public key.
# Enable Cloud Vision API and billing in Google Cloud before opting in.
GOOGLE_VISION_API_KEY=
IMAGE_WEB_CHECK_ENABLED=false
# Shared UTC image attempts; 0 pauses checks. Other Google project usage can be billed.
IMAGE_WEB_DAILY_LIMIT=100
IMAGE_WEB_MONTHLY_LIMIT=1000
TOMTOM_API_KEY=
TOMTOM_ENABLED=false
TOMTOM_INCIDENT_CACHE_SECONDS=300
# Optional private Supabase Storage instead of a Railway volume.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=civigo-attachments

# Optional place photos, hours and community ratings. Private Railway key.
FOURSQUARE_ENABLED=false
FOURSQUARE_SERVICE_KEY=
FOURSQUARE_DAILY_REQUEST_LIMIT=200

# Web Premium: hosted Mercado Pago Checkout Pro, PEN, one payment for 30 days.
# Test mode requires the APP_USR credentials of a test seller account.
# Both modes redirect to init_point. Test payments never grant real benefits.
PAYMENTS_ENABLED=false
PAYMENTS_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PREMIUM_PRICE_PEN_CENTS=100
# Public HTTPS backend origin (without /api). PUBLIC_APP_URL must also be HTTPS.
PUBLIC_API_URL=

# Optional operational metrics (aggregates only, private to administrators).
# Defaults to enabled outside tests. No additional service token is needed.
TELEMETRY_ENABLED=true

# Optional cap for Gmail verification-code requests; Resend credentials are reused.
EMAIL_CODE_DAILY_LIMIT=100
