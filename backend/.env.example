NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?connection_limit=1&pgbouncer=true&statement_cache_size=0
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Solo IP/CIDR del proxy que sobrescribe X-Forwarded-For y protege el acceso directo.
# Vacío no confía en cabeceras recibidas. No habilitarlo solo por usar Next.js.
TRUST_PROXY=
COOKIE_SAME_SITE=lax
UPLOAD_DIR=.local/uploads
ENABLE_JOBS=true

# Solo pruebas locales; nunca activarlo en producción.
DEMO_VERIFICATION=false
DEMO_PASSWORD=
ADMIN_EMAIL=

# Verificación por SMS o WhatsApp mediante Twilio Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Correo y recuperación de cuenta mediante Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Evaluación opcional de reportes y asistente; la ausencia activa revisión humana.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions

# URL separada para pruebas; exige autorización explícita si es remota.
TEST_DATABASE_URL=
ALLOW_REMOTE_TESTS=false
ALLOW_REMOTE_DEMO_SEED=false

# Servidor PostgreSQL local para desarrollo.
LOCAL_DB_PORT=55432
LOCAL_DB_DIR=.local/postgres
