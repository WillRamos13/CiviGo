generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  usuario        User      @relation(fields: [usuarioId], references: [id])
  tipo           String
  descripcion    String
  latitud        Float
  longitud       Float
  nivelRiesgo    Int       @default(1)
  estado         String    @default("Reportado")
  confirmaciones Int       @default(0)
  imagen         String?
  incidenteId    Int?
  incidente      Incident? @relation("ReportesIncidente", fields: [incidenteId], references: [id])
  fechaEvento    DateTime  @default(now())
  fechaCreacion  DateTime  @default(now())
}

model Incident {
  id            Int      @id @default(autoincrement())
  tipo          String
  latitud       Float
  longitud      Float
  nivelRiesgo   Int      @default(1)
  estado        String   @default("ACTIVO")
  totalReportes Int      @default(1)
  fechaCreacion DateTime @default(now())
  reportes      Report[] @relation("ReportesIncidente")
}

model User {
  id            Int      @id @default(autoincrement())
  nombreUsuario String   @unique
  correo        String   @unique
  telefono      String   @unique
  password      String
  reputacion    Int      @default(100)
  rol           String   @default("USUARIO")
  fechaCreacion DateTime @default(now())
  reportes      Report[]
}
