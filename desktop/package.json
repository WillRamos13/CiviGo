{
  "name": "civigo-administracion",
  "version": "0.1.0",
  "private": true,
  "description": "Administración privada de CiviGo para Windows",
  "author": "CiviGo",
  "packageManager": "npm@11.12.1",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "setup:electron": "node node_modules/electron/install.js",
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs",
    "test:package": "electron tests/electron-smoke.cjs --package",
    "pack": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "online.civigo.administracion",
    "productName": "CiviGo Administración",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "public/civigo-icon.ico", "signExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "artifactName": "CiviGo-Administracion-Instalador-${version}.${ext}"
    },
    "portable": { "artifactName": "CiviGo-Administracion-Portable-${version}.${ext}" }
  }
}
